# AI Council V22.1 — strict Free API Cascade / no Local Engine.
# Never commit real credentials.

# OPENAI_API_KEY = "..."
# GEMINI_API_KEY = "..."
# ANTHROPIC_API_KEY = "..."
# XAI_API_KEY = "..."
# KIMI_API_KEY = "..."
# DEEPSEEK_API_KEY = "..."
# Current official DeepSeek API candidates; configure only models you are authorized to use.
# DEEPSEEK_FREE_MODELS = "deepseek-v4-flash,deepseek-v4-pro,deepseek-v4-flash-vision-exp"
# MOONSHOT_API_KEY = "..."

# Explicitly configured model candidates only; unknown IDs are filtered by the zero-cost policy.
# GEMINI_FREE_MODELS = "gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite"
#
# Google Gemini API usage is free only while the project is on the Free Tier.
# Do not link paid billing for the strict zero-cost deployment.
# GEMINI_API_ZERO_COST_CONFIRMED = "false"
#
# Optional GroqCloud agent (separate from the xAI Grok seat above).
# Use only while the Groq organization/account remains on the Free Plan.
# Free Plan model IDs approved by the application: GPT-OSS 120B and GPT-OSS 20B.
# GROQ_CLOUD_API_KEY = "..."
# GROQ_CLOUD_FREE_MODELS = "openai/gpt-oss-120b,openai/gpt-oss-20b"
# GROQ_CLOUD_FREE_PLAN_CONFIRMED = "false"
# Add dynamic room seat 8 using this exact JSON:
# AI_COUNCIL_EXTRA_AGENTS = '[{"key":"groqcloud","name":"GroqCloud","credential_names":["GROQ_CLOUD_API_KEY"],"model_names":["GROQ_CLOUD_FREE_MODELS"],"endpoint":"https://api.groq.com/openai/v1/chat/completions","kind":"chat_completions"}]'
# ANTHROPIC_FREE_MODELS = "model-1,model-2"
# GROK_FREE_MODELS = "model-1,model-2"  # explicit Free candidates only; max 10
# XAI_FREE_MODELS = "model-1,model-2"  # backward-compatible alias
# KIMI_FREE_MODELS = "model-1,model-2"

# PROVIDER_TIMEOUT_SECONDS = "45"
# GEMINI_REQUEST_TIMEOUT_SECONDS = "10"  # per-model Gemini HTTP attempt; cascade continues on timeout
# MAX_OUTPUT_TOKENS = "1200"
# GEMINI_TRANSCRIBE_MODEL = "explicit-model-id"

# Optional additional agents. JSON only; credentials are referenced by secret names.
# Example: AI_COUNCIL_EXTRA_AGENTS = '[{"key":"perplexity","name":"Perplexity","credential_names":["PERPLEXITY_API_KEY"],"model_names":["PERPLEXITY_FREE_MODELS"],"endpoint":"https://api.perplexity.ai/chat/completions","kind":"chat_completions"}]'

# DeepSeek V4 latency control: disabled is the fast conversational default; set enabled explicitly for reasoning.
# DEEPSEEK_THINKING_MODE = "disabled"

# Supabase durable conversation storage / email-password Auth.
# Keep these in Streamlit Community Cloud Secrets, never in Git.
# Leave Auth disabled until the live two-account Auth/PostgREST acceptance test passes.
# SUPABASE_AUTH_ENABLED = "false"
# SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
# SUPABASE_PUBLISHABLE_KEY = "sb_publishable_YOUR_PUBLIC_KEY"
