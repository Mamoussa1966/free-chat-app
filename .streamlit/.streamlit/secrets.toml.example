# Copy these values into Streamlit Cloud -> App -> Settings -> Secrets.
# NEVER commit real API keys to GitHub.

# OPENAI_API_KEY = "..."
# GEMINI_API_KEY = "..."
# ANTHROPIC_API_KEY = "..."
# XAI_API_KEY = "..."
# KIMI_API_KEY = "..."
# MOONSHOT_API_KEY = "..."

# Optional model overrides.
# OPENAI_MODELS = "gpt-5.6,gpt-5.6-luna,gpt-5.6-terra"
# GEMINI_MODELS = "gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash"
# ANTHROPIC_MODELS = "claude-sonnet-5,claude-opus-5,claude-fable-5,claude-haiku-4-5"
# XAI_MODELS = "grok-4.6,grok-4.3"
# KIMI_MODELS = "kimi-k3,kimi-k2.5"

# Optional operational controls.
# PROVIDER_TIMEOUT_SECONDS = "45"
# MAX_OUTPUT_TOKENS = "1200"

# Optional dedicated voice transcription model.
# This is intentionally separate from GEMINI_MODELS.
# GEMINI_TRANSCRIBE_MODEL = "gemini-3.5-transcribe"
