# AI Council V22 — Free API Cascade only
# NEVER commit real API keys to GitHub.
# Put these values in Streamlit Cloud -> App -> Settings -> Secrets.

# Official provider credentials
# OPENAI_API_KEY = "..."
# GEMINI_API_KEY = "..."
# ANTHROPIC_API_KEY = "..."
# XAI_API_KEY = "..."
# KIMI_API_KEY = "..."
# or:
# MOONSHOT_API_KEY = "..."

# ============================================================
# FREE MODEL CASCADE
# ============================================================
#
# Maximum 10 models:
#
# Free #1
# Free #2
# Free #3
# ...
# Free #10
#
# Only put models that are genuinely Free API
# for YOUR provider/account.
#
# The application NEVER inserts paid models automatically.
# The application NEVER falls back to Local Engine.
# ============================================================

# OpenAI
# Configure only if your OpenAI API account explicitly
# provides zero-cost API access to these model IDs.
# OPENAI_FREE_MODELS = "free-model-1,free-model-2"

# Gemini
# Current documented Free Tier examples:
# GEMINI_FREE_MODELS = "gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview"

# Anthropic / Claude
# Configure only models explicitly granted at zero API cost.
# ANTHROPIC_FREE_MODELS = "free-model-1,free-model-2"

# xAI / Grok
# Configure only models explicitly granted at zero API cost.
# XAI_FREE_MODELS = "free-model-1,free-model-2"

# Kimi / Moonshot
# Configure only models explicitly granted at zero API cost.
# KIMI_FREE_MODELS = "free-model-1,free-model-2"

# ============================================================
# OPERATIONAL CONTROLS
# ============================================================

# PROVIDER_TIMEOUT_SECONDS = "45"
# MAX_OUTPUT_TOKENS = "1200"

# Dedicated voice transcription model.
# This is separate from the council Free Model cascade.
# GEMINI_TRANSCRIBE_MODEL = "gemini-3.5-transcribe"
