# AI Council V22.1 — STRICT FREE API CASCADE / NO LOCAL ENGINE / HARDENED HOTFIX 6
# Never commit real credentials.
# Configure these in Streamlit Cloud Secrets or environment variables.

# Official credentials
# OPENAI_API_KEY = "..."
# GEMINI_API_KEY = "..."
# ANTHROPIC_API_KEY = "..."
# XAI_API_KEY = "..."
# KIMI_API_KEY = "..."
# MOONSHOT_API_KEY = "..."

# Ordered, explicitly Free API models only. Maximum 10 per provider.
# The application never invents a model and never assumes a model is free.
# OPENAI_FREE_MODELS = "model-1,model-2"
# GEMINI_FREE_MODELS = "model-1,model-2"
# ANTHROPIC_FREE_MODELS = "model-1,model-2"
# XAI_FREE_MODELS = "model-1,model-2"
# KIMI_FREE_MODELS = "model-1,model-2"

# Optional operational controls
# PROVIDER_TIMEOUT_SECONDS = "45"
# MAX_OUTPUT_TOKENS = "1200"

# Voice transcription is separate from the council and requires an explicit model.
# GEMINI_TRANSCRIBE_MODEL = "your-explicit-transcription-model"
