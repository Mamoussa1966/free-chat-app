# AI Council V22.1 — strict Free API Cascade / no Local Engine.
# NEVER commit real credentials to GitHub.

# Provider credentials (server-side only).
# GEMINI_API_KEY = "..."
# OPENAI_API_KEY = "..."
# ANTHROPIC_API_KEY = "..."
# XAI_API_KEY = "..."
# KIMI_API_KEY = "..."
# MOONSHOT_API_KEY = "..."

# AUTHORITATIVE Free API model lists.
# These are the ONLY model IDs the application may call for that provider.
# Maximum: 10 IDs per provider. Use ordinary ASCII commas (,).
# Do not use the Unicode punctuation character `‚`.
# GEMINI_FREE_MODELS = "gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash"
# OPENAI_FREE_MODELS = "model-1,model-2"
# ANTHROPIC_FREE_MODELS = "model-1,model-2"
# XAI_FREE_MODELS = "model-1,model-2"
# KIMI_FREE_MODELS = "model-1,model-2"

# Operational controls.
# PROVIDER_TIMEOUT_SECONDS = "45"
# MAX_OUTPUT_TOKENS = "1200"

# Optional dedicated voice transcription model.
# This is separate from the council Free cascade.
# GEMINI_TRANSCRIBE_MODEL = "explicit-model-id"
