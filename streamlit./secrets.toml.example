# AI Council V22.1 — strict Free API Cascade / no Local Engine.
# Never commit real credentials.

# OPENAI_API_KEY = "..."
# GEMINI_API_KEY = "..."
# ANTHROPIC_API_KEY = "..."
# XAI_API_KEY = "..."
# KIMI_API_KEY = "..."
# DEEPSEEK_API_KEY = "..."
# Current official DeepSeek API candidates; configure only models you are authorized to use.
# DEEPSEEK_FREE_MODELS = "deepseek-v4-flash,deepseek-v4-pro,deepseek-v4-flash-vision-exp"
# MOONSHOT_API_KEY = "..."

# Explicitly configured Free candidates only; max 10 per provider.
# OPENAI_FREE_MODELS = "model-1,model-2"
# GEMINI_FREE_MODELS = "model-1,model-2"  # max 10; use standard ASCII commas
# ANTHROPIC_FREE_MODELS = "model-1,model-2"
# GROK_FREE_MODELS = "model-1,model-2"  # explicit Free candidates only; max 10
# XAI_FREE_MODELS = "model-1,model-2"  # backward-compatible alias
# KIMI_FREE_MODELS = "model-1,model-2"

# PROVIDER_TIMEOUT_SECONDS = "45"
# GEMINI_REQUEST_TIMEOUT_SECONDS = "10"  # per-model Gemini HTTP attempt; cascade continues on timeout
# MAX_OUTPUT_TOKENS = "1200"
# GEMINI_TRANSCRIBE_MODEL = "explicit-model-id"

# Optional additional agents. JSON only; credentials are referenced by secret names.
# Example: AI_COUNCIL_EXTRA_AGENTS = '[{"key":"perplexity","name":"Perplexity","credential_names":["PERPLEXITY_API_KEY"],"model_names":["PERPLEXITY_FREE_MODELS"],"endpoint":"https://api.perplexity.ai/chat/completions","kind":"chat_completions"}]'
