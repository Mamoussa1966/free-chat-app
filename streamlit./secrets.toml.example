# AI Council V22.1 — 20-provider Free API Cascade / No Local
# NEVER commit real API keys to GitHub.
# Streamlit Cloud: App -> Settings -> Secrets

# Provider credentials
# OPENAI_API_KEY = "..."
# GEMINI_API_KEY = "..."
# ANTHROPIC_API_KEY = "..."
# GROQ_API_KEY = "..."
# OPENROUTER_API_KEY = "..."
# COHERE_API_KEY = "..."
# MISTRAL_API_KEY = "..."
# XAI_API_KEY = "..."
# DEEPSEEK_API_KEY = "..."
# TOGETHER_API_KEY = "..."
# PERPLEXITY_API_KEY = "..."
# FIREWORKS_API_KEY = "..."
# REPLICATE_API_TOKEN = "..."
# HF_TOKEN = "..."
# AI21_API_KEY = "..."
# KIMI_API_KEY = "..."       # or MOONSHOT_API_KEY
# DASHSCOPE_API_KEY = "..."
# ZHIPU_API_KEY = "..."      # or ZAI_API_KEY
# DEEPINFRA_API_KEY = "..."  # or DEEPINFRA_TOKEN
# ANYSCALE_API_KEY = "..."

# IMPORTANT:
# Every *_FREE_MODELS value is an ordered cascade of at most 10 model IDs.
# The application does NOT guess, inject, or silently select paid models.
# Only add a model when your own provider account explicitly permits that
# model under the Free/zero-cost API entitlement you intend to use.
# Comma, semicolon, or newline separators are accepted.

# OPENAI_FREE_MODELS = "model-a,model-b"
# GEMINI_FREE_MODELS = "model-a,model-b"
# ANTHROPIC_FREE_MODELS = "model-a,model-b"
# GROQ_FREE_MODELS = "model-a,model-b"
# OPENROUTER_FREE_MODELS = "model-a,model-b"
# COHERE_FREE_MODELS = "model-a,model-b"
# MISTRAL_FREE_MODELS = "model-a,model-b"
# XAI_FREE_MODELS = "model-a,model-b"
# DEEPSEEK_FREE_MODELS = "model-a,model-b"
# TOGETHER_FREE_MODELS = "model-a,model-b"
# PERPLEXITY_FREE_MODELS = "model-a,model-b"
# FIREWORKS_FREE_MODELS = "model-a,model-b"
# REPLICATE_FREE_MODELS = "owner/model,owner/another-model"
# HF_FREE_MODELS = "org/model:provider,org/model:provider"
# AI21_FREE_MODELS = "model-a,model-b"
# KIMI_FREE_MODELS = "model-a,model-b"
# DASHSCOPE_FREE_MODELS = "model-a,model-b"
# ZHIPU_FREE_MODELS = "model-a,model-b"
# DEEPINFRA_FREE_MODELS = "model-a,model-b"
# ANYSCALE_FREE_MODELS = "model-a,model-b"

# Optional aliases accepted by the runtime:
# CLAUDE_FREE_MODELS, GROK_FREE_MODELS, MOONSHOT_FREE_MODELS,
# HUGGINGFACE_FREE_MODELS, ZAI_FREE_MODELS

# Operational controls
# PROVIDER_TIMEOUT_SECONDS = "45"
# MAX_OUTPUT_TOKENS = "1200"

# Dedicated Gemini transcription model. Current official default is
# gemini-3.5-transcribe; override only if your account supports another model.
# GEMINI_TRANSCRIBE_MODEL = "gemini-3.5-transcribe"
